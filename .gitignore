# Deploy bundles are generated from the tracked sources by zipping
# index.html, sw.js, manifest.webmanifest, the icons and _headers.
# They are rebuilt for every release, so keeping them in history would
# add a few hundred KB of binary per deploy for nothing recoverable.
potting-bench-netlify.zip
*.zip

# macOS
.DS_Store

# Redesign QA screenshots and playwright-cli session artifacts —
# local review material, not part of the app.
/redesign-screens/
/.playwright-cli/

# Per-machine Claude Code permission grants. The launch config beside it IS
# tracked — everyone wants the same dev server — but these are one person's
# answers to one machine's prompts and mean nothing on anybody else's.
.claude/settings.local.json
