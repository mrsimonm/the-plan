rules_version = '2';

// Teachbench student app — Firestore security rules.
//
// Roles:
//   owner    staff/{uid}.role == "owner"   — everything, all students, manages staff
//   teacher  staff/{uid}.role == "teacher" — only students whose teacherId is their uid
//   student  anonymous Auth uid mapped to a studentId via studentAuth/{uid}
//
// Everything not explicitly allowed below is denied (Firestore default).
// Paste the whole file into Firebase console → Firestore → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }
    function isStaff() { return signedIn() && exists(staffPath()); }
    function isOwner() { return isStaff() && get(staffPath()).data.role == "owner"; }

    function studentDoc(studentId) {
      return get(/databases/$(database)/documents/teachbenchStudents/$(studentId)).data;
    }
    // owner: any student. teacher: only students assigned to them.
    function canManage(studentId) {
      return isOwner()
        || (isStaff() && studentDoc(studentId).teacherId == request.auth.uid);
    }

    function authPath() {
      return /databases/$(database)/documents/studentAuth/$(request.auth.uid);
    }
    function isThisStudent(studentId) {
      return signedIn() && exists(authPath())
        && get(authPath()).data.studentId == studentId;
    }

    // A student may only touch the spaced-repetition scheduling fields of a
    // card — never its content, type, or which student it belongs to.
    //
    // The card also carries `example`, an optional sentence the teacher
    // writes, which the review screen turns into a gap-fill. It is
    // deliberately NOT in this list: a student who could edit the example
    // could edit the answer out of their own card.
    function onlyReviewFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['intervalStage', 'easeFactor', 'intervalDays',
         'nextReviewDate', 'lastReviewedAt', 'reviewCount', 'lapses']);
    }

    // A message, once sent, is a record of what somebody actually said.
    // The only thing either side may change afterwards is the marker
    // saying they have now seen it — never the words themselves.
    function onlyReadReceiptChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }

    // ---------- staff ----------
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      // The first owner document is still created by hand in the console —
      // that is a genuine bootstrap and happens once in the life of the
      // project. After that the owner can add or change staff directly...
      allow create, update, delete: if isOwner();

      // ...and a NEW teacher can write their own row, but only while holding
      // an invite the owner actually issued. This is what stops every new
      // teacher being a console job without making staff self-service: a
      // teacher can read all of their students' work, so open registration
      // here would hand anyone who found the URL a way into children's
      // records.
      //
      // Same shape as roomOrgs/members: .get() with a default that can never
      // match a real invite (a row with no inviteHash must be DENIED, not
      // error the request out), the invite must exist, and the role claimed
      // must be the role the invite names — so a teacher's code cannot be
      // redeemed into an owner account.
      // The invite must exist, must name the role being claimed, and must not
      // have run out. The expiry is checked HERE and not only in the client,
      // because a client check is a courtesy and a rule is a control.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('inviteHash', '') != ''
        && exists(/databases/$(database)/documents/staffInvites/$(request.resource.data.get('inviteHash','x')))
        && get(/databases/$(database)/documents/staffInvites/$(request.resource.data.get('inviteHash','x'))).data.role == request.resource.data.role
        && request.time.toMillis()
             < get(/databases/$(database)/documents/staffInvites/$(request.resource.data.get('inviteHash','x'))).data.get('expiresAtMs', 0);

      // Your own name is yours; your role is not. Without this an account
      // could quietly promote itself to owner after redeeming a teacher code.
      //
      // inviteHash is frozen for the same reason, and the reason is easy to
      // miss: the staffInvites delete rule below derives authority FROM this
      // field — it lets you revoke the invite your row names. Left writable,
      // a teacher who happened to know a colleague's code could point their
      // own row at that hash and burn it, revoking an invite meant for
      // somebody else. No escalation and no read, since role is still pinned
      // and invites cannot be listed, but a nuisance the owner would struggle
      // to explain. A field that grants authority has to be as immutable as
      // the field that grants role.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('inviteHash','') == resource.data.get('inviteHash','');
    }

    // ---------- teacher invite codes ----------
    // Doc id is the SHA-256 of the code, exactly as accessCodes and
    // roomInvites work: one get by exact id means you already knew the code,
    // and listing is owner-only, so codes cannot be enumerated into a way in.
    //
    // A get is open to any signed-in account, an anonymous one included,
    // because the person redeeming has no account yet — the app signs in
    // anonymously, checks the code, and only then creates the real account,
    // so a wrong code strands no half-made user behind it.
    // Single-use, and short-lived. An invite that merely has to EXIST — the
    // way roomInvites works — mints unlimited accounts for ever once it
    // leaks. That is a survivable trade for a room booking and not one for a
    // token that opens children's records, so a staff invite is burnt on
    // redemption and expires on its own if it never is.
    match /staffInvites/{codeHash} {
      allow get: if signedIn();
      allow list: if isOwner();
      // The lifetime is capped HERE and not only in the client, because the
      // client writing these IS the owner's, and an owner could otherwise
      // hand-write an invite that never expires.
      //
      // A teacher invite buys an empty account — teachbenchStudents is gated
      // on canManage(), so a redeemed teacher reads nothing until students
      // are assigned to them — and gets a fortnight. An owner invite
      // satisfies canManage() for every student unconditionally, so it IS
      // the database, and gets a day.
      //
      // The five minutes of slack absorbs clock skew: the client computes
      // the stamp from its own clock, and a device running slightly fast
      // would otherwise have its own invites refused.
      allow create: if isOwner()
        && request.resource.data.role in ['owner', 'teacher']
        && request.resource.data.expiresAtMs is number
        && request.resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 300000
             + (request.resource.data.role == 'owner' ? 86400000 : 1209600000);
      allow update: if false;
      // The owner may revoke any invite. Beyond that, exactly one other
      // account may delete this one: the account that just redeemed it,
      // identified by its own staff row carrying this very hash. That is
      // narrow on purpose — "anyone signed in may delete an invite" would
      // let a stranger revoke every code the owner has outstanding.
      allow delete: if isOwner()
        || (signedIn()
            && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
            && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('inviteHash','') == codeHash);
    }

    // ---------- access codes ----------
    // Doc id is the SHA-256 hex of the plain code. A signed-in (anonymous)
    // client may fetch ONE doc by exact id — i.e. it must already know the
    // code. Listing is owner-only, so codes cannot be enumerated.
    match /accessCodes/{codeHash} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow create: if canManage(request.resource.data.studentId);
      allow delete: if canManage(resource.data.studentId);
      allow update: if false;
    }

    // ---------- device → student mapping ----------
    // Written once by the student's own device after redeeming a code.
    // Idempotent: a wiped browser simply redeems again under a new uid.
    match /studentAuth/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isOwner();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId', 'codeHash', 'createdAt'])
        && exists(/databases/$(database)/documents/accessCodes/$(request.resource.data.codeHash))
        && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.codeHash))
             .data.studentId == request.resource.data.studentId;
      allow update: if false;
      // staff can revoke a device for a student they manage
      allow delete: if canManage(resource.data.studentId);
    }

    // ---------- students ----------
    match /teachbenchStudents/{studentId} {
      allow get: if canManage(studentId) || isThisStudent(studentId);
      // teachers list with where('teacherId','==',uid); owner lists all
      allow list: if isOwner()
        || (isStaff() && resource.data.teacherId == request.auth.uid);
      allow create: if isStaff()
        && (isOwner() || request.resource.data.teacherId == request.auth.uid);
      // a teacher cannot reassign a student to someone else; owner can
      allow update: if canManage(studentId)
        && (isOwner() || request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if canManage(studentId);

      match /flashcards/{cardId} {
        allow read: if canManage(studentId) || isThisStudent(studentId);
        allow create, delete: if canManage(studentId);
        allow update: if canManage(studentId)
          || (isThisStudent(studentId) && onlyReviewFieldsChanged());
      }

      /* A student's own record of their study habit: streak, points,
         and a short per-day history. Written by the student because it
         is a by-product of them reviewing; readable by their teacher so
         it can show up on the dashboard. Yes, a determined child could
         inflate their own streak — it is their own motivation data and
         nobody else is harmed by it, so it is not worth the complexity
         of moving these writes somewhere they cannot reach. */
      match /progress/{docId} {
        allow read: if canManage(studentId) || isThisStudent(studentId);
        allow create, update: if isThisStudent(studentId);
        allow delete: if canManage(studentId);
      }

      match /homework/{itemId} {
        allow read: if canManage(studentId) || isThisStudent(studentId);
        allow create: if canManage(studentId)
          || (isThisStudent(studentId)
              && request.resource.data.direction == "student-to-teacher");
        // student may only flip status (e.g. mark as read)
        allow update: if canManage(studentId)
          || (isThisStudent(studentId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
        allow delete: if canManage(studentId);
      }

      /* Free conversation, kept apart from homework on purpose: homework
         is a piece of work with a state, this is a student saying "I'm
         ill today" or "what did you mean by that". Each side may only
         ever write in its own voice — the direction is checked against
         who is asking, so a student cannot author a message that appears
         to have come from their teacher. */
      match /messages/{msgId} {
        allow read: if canManage(studentId) || isThisStudent(studentId);

        // .get() rather than a bare field read: an absent readAt should
        // mean "unread", not a denied write on a rule that errored.
        allow create: if request.resource.data.get('readAt', null) == null
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (
               (canManage(studentId)
                 && request.resource.data.direction == "teacher-to-student")
            || (isThisStudent(studentId)
                 && request.resource.data.direction == "student-to-teacher")
          );

        // Only the recipient marks a message read, and marking read is
        // the only edit either side can make.
        allow update: if onlyReadReceiptChanged()
          && (
               (canManage(studentId)
                 && resource.data.direction == "student-to-teacher")
            || (isThisStudent(studentId)
                 && resource.data.direction == "teacher-to-student")
          );

        // A student cannot delete what they said, so a difficult message
        // cannot be quietly withdrawn before the teacher reads it.
        allow delete: if canManage(studentId);
      }
    }

    // ========================================================================
    // ROOMS — a venue's own booking calendar.
    //
    // Five kinds of person, and the whole file turns on telling them apart:
    //
    //   owner    roomOrgs/{o}.ownerUid == uid    — everything, incl. deleting
    //   admin    members/{uid}.role == "admin"   — everything but that
    //   member   members/{uid} exists            — books for themselves
    //   viewer   members/{uid}.role == "viewer"  — reads, never writes
    //   guest    an anonymous uid with no member row — sees free/busy only
    //
    // The one thing rules cannot do is check whether two bookings overlap:
    // that needs a read of the other rows mid-write, which only a transaction
    // can do. So the client holds a per-room-per-day "guard" document and
    // does the overlap check inside a Firestore transaction; these rules
    // guard ownership, roles and reach. Losing that race writes a double
    // booking, not a security hole.
    // ========================================================================

    function rbOrg(o)    { return get(/databases/$(database)/documents/roomOrgs/$(o)).data; }
    function rbIsOwner(o){ return signedIn() && rbOrg(o).ownerUid == request.auth.uid; }
    function rbMePath(o) { return /databases/$(database)/documents/roomOrgs/$(o)/members/$(request.auth.uid); }
    function rbIsMember(o){ return signedIn() && exists(rbMePath(o)); }
    function rbMe(o)     { return get(rbMePath(o)).data; }
    function rbIsAdmin(o){ return rbIsOwner(o) || (rbIsMember(o) && rbMe(o).role == "admin"); }
    // a viewer is a door display or a manager: it may look and nothing else
    function rbCanBook(o){ return rbIsMember(o) && rbMe(o).role != "viewer"; }

    // ---------- which venues an account belongs to ----------
    // Strictly the account's own list. Nobody else can read who you book with.
    match /roomUsers/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ---------- the public directory behind a booking link ----------
    // Deliberately readable by anyone signed in, including an anonymous
    // guest: it maps a slug in a URL to a venue and carries nothing else.
    match /roomSlugs/{slug} {
      allow get: if signedIn();
      allow list: if false;                         // not a directory to browse
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orgId','name'])
        && rbIsOwner(request.resource.data.orgId);
      allow update, delete: if signedIn() && rbIsAdmin(resource.data.orgId);
    }

    // ---------- invite codes ----------
    // Doc id is the SHA-256 of the code, exactly as accessCodes works above:
    // one get by exact id means you already knew the code, and listing is
    // closed, so codes cannot be enumerated into a way in.
    match /roomInvites/{codeHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && rbIsAdmin(request.resource.data.orgId);
      allow delete: if signedIn() && rbIsAdmin(resource.data.orgId);
      allow update: if false;
    }

    // ---------- the outbox ----------
    // Notifications the app has composed but cannot itself send: a static
    // page has no mail server. Documents here are written in the shape
    // Firebase's "Trigger Email from Firestore" extension consumes, so
    // installing that extension against this collection is what actually
    // puts them on the wire.
    //
    // The one thing that matters here is that this is NOT an open relay.
    // Only a MEMBER of the venue named on the document may create one, which
    // is why a guest's own device never queues its own mail — an admin's
    // device does it for them on the next sweep. Without that check anyone
    // with an anonymous account could use a venue's mail extension to send
    // whatever they liked to whoever they liked, over the venue's domain.
    //
    // Nobody reads anybody's mail: only staff, and only to count what is
    // waiting. The extension runs with admin rights and ignores these rules,
    // so restricting reads costs it nothing.
    match /roomMail/{id} {
      allow get, list: if signedIn() && rbIsAdmin(resource.data.orgId);
      allow create: if signedIn()
        && request.resource.data.orgId is string
        && rbIsMember(request.resource.data.orgId)
        && rbMe(request.resource.data.orgId).role != 'viewer'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.to is list
        && request.resource.data.to.size() <= 5
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string;
      // The extension stamps its own delivery state on the document, which it
      // does with admin rights. Nothing in the app may rewrite a queued
      // message, and only staff may clear one out.
      allow update: if false;
      allow delete: if signedIn() && rbIsAdmin(resource.data.orgId);
    }

    // ---------- the venue ----------
    match /roomOrgs/{orgId} {
      // Any signed-in account may read the venue itself: a guest arriving on
      // the public link needs its name, its currency and its slot size before
      // it can show them anything at all.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if rbIsAdmin(orgId);
      allow delete: if rbIsOwner(orgId);

      // ---- members ----
      // A member row is what grants a role, so nobody may write their own
      // beyond the moment they redeem an invite — and the invite has to
      // actually exist and name this venue and this role.
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || rbIsMember(orgId));
        allow list: if rbIsMember(orgId);
        // .get() with a default rather than a bare field read: a row that
        // simply has no inviteHash must be denied, not error the request out.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.get('inviteHash', '') != ''
          && exists(/databases/$(database)/documents/roomInvites/$(request.resource.data.get('inviteHash','x')))
          && get(/databases/$(database)/documents/roomInvites/$(request.resource.data.get('inviteHash','x'))).data.orgId == orgId
          && get(/databases/$(database)/documents/roomInvites/$(request.resource.data.get('inviteHash','x'))).data.role == request.resource.data.role;
        allow create, update, delete: if rbIsAdmin(orgId);
        // your own name and phone are yours; your role and your tariff are not
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.tariffId == resource.data.tariffId;
      }

      // ---- the rooms and what they cost ----
      // Readable by anyone signed in, because a guest has to see the rooms
      // and their prices to ask for one. Written only by staff.
      match /spaces/{id}  { allow read: if signedIn();  allow write: if rbIsAdmin(orgId); }
      match /tariffs/{id} { allow read: if signedIn();  allow write: if rbIsAdmin(orgId); }
      match /closures/{id}{ allow read: if signedIn();  allow write: if rbIsAdmin(orgId); }
      match /series/{id}  { allow read: if rbIsMember(orgId); allow write: if rbCanBook(orgId); }

      // ---- guests ----
      // A guest's own record is keyed by their anonymous uid, so "only your
      // own" is checkable. Staff see all of them; guests see none but theirs.
      match /guests/{id} {
        allow get: if rbIsMember(orgId) || (signedIn() && request.auth.uid == id);
        allow list: if rbIsMember(orgId);
        allow create, update: if rbIsAdmin(orgId)
          || (signedIn() && request.auth.uid == id);
        allow delete: if rbIsAdmin(orgId);
      }

      // ---- bookings ----
      // The row that matters. A member may only write one that is theirs, may
      // not confirm one on a room whose rules say it needs approving, and may
      // not quietly re-price it. Staff may do all three, which is what being
      // staff means. Everyone who is not a member reads only their own.
      match /bookings/{id} {
        allow get, list: if rbIsMember(orgId)
          || (signedIn() && resource.data.bookerId == request.auth.uid);

        allow create: if rbIsAdmin(orgId)
          || (signedIn()
              && request.resource.data.bookerId == request.auth.uid
              && request.resource.data.state in ['held','requested','confirmed']
              && request.resource.data.invoiceId == null);

        // your own booking: you may fill it in, confirm it, or cancel it —
        // you may not hand yourself somebody else's, and you may not touch
        // one that has already been invoiced.
        allow update: if rbIsAdmin(orgId)
          || (signedIn()
              && resource.data.bookerId == request.auth.uid
              && request.resource.data.bookerId == request.auth.uid
              && resource.data.invoiceId == null
              && request.resource.data.state in ['held','requested','confirmed','cancelled']);

        // Cancelling is a state, not a deletion: a booking that was made and
        // called off is a thing that happened, and the venue may need to bill
        // for it. Only staff may make one disappear.
        allow delete: if rbIsAdmin(orgId)
          || (signedIn() && resource.data.bookerId == request.auth.uid
              && resource.data.state == 'held');
      }

      // ---- the guards: who has which minutes of which room ----
      // Anyone signed in may read these, and they are written to carry no
      // words at all — {id, from, to, state} — so an outsider on the public
      // link learns that 14:00 is taken and never who has it or what for.
      // Anyone who may book may write them, because the overlap check that
      // makes them meaningful happens inside the client's transaction.
      match /guards/{id} {
        allow read: if signedIn();
        allow write: if rbCanBook(orgId) || rbIsAdmin(orgId)
          || (signedIn() && !exists(rbMePath(orgId)));   // a guest holding a slot
      }

      // ---- invoices and the audit trail ----
      // Money is staff-only, except that you may read an invoice addressed
      // to you. The audit log can be added to by anyone who can act, and
      // altered by nobody at all — a log you can edit is not a log.
      match /invoices/{id} {
        allow get: if rbIsAdmin(orgId)
          || (signedIn() && resource.data.billTo.id == request.auth.uid);
        allow list: if rbIsAdmin(orgId);
        allow write: if rbIsAdmin(orgId);
      }
      match /audit/{id} {
        allow read: if rbIsAdmin(orgId);
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    // ---------- potting bench: one person's own app state ----------
    // Cross-device sync for the main app (data and schedules; photos are
    // never uploaded). Strictly private: a document under users/{userId}
    // is readable and writable only by that signed-in account, and by
    // nobody else at all — not other staff, not the owner. Anonymous
    // student devices can never reach it, because their uid is not the
    // uid in the path.
    match /users/{userId}/state/{docId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

  }
}
