rules_version = '2';

// Teachbench student app — Cloud Storage security rules (homework photos).
// Mirrors firestore.rules: owner sees all, a teacher only their own
// students, a student only their own folder. Role lookups read Firestore
// directly (cross-service rules).
//
// Paste into Firebase console → Storage → Rules → Publish.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }

    function staffPath() {
      return /databases/(default)/documents/staff/$(request.auth.uid);
    }
    function isStaff() { return signedIn() && firestore.exists(staffPath()); }
    function isOwner() {
      return isStaff() && firestore.get(staffPath()).data.role == "owner";
    }
    function canManage(studentId) {
      return isOwner() || (isStaff()
        && firestore.get(/databases/(default)/documents/teachbenchStudents/$(studentId))
             .data.teacherId == request.auth.uid);
    }
    function authPath() {
      return /databases/(default)/documents/studentAuth/$(request.auth.uid);
    }
    function isThisStudent(studentId) {
      return signedIn() && firestore.exists(authPath())
        && firestore.get(authPath()).data.studentId == studentId;
    }

    // teachbenchHomework/{studentId}/{homeworkItemId}/{fileName}
    match /teachbenchHomework/{studentId}/{itemId}/{fileName} {
      allow read: if canManage(studentId) || isThisStudent(studentId);
      allow write: if (canManage(studentId) || isThisStudent(studentId))
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024        // 10 MB cap
        && request.resource.contentType.matches('image/.*'); // images only
      allow delete: if canManage(studentId);
    }

    // pottingbenchPhotos/{userId}/{photoId}
    // A plant photo, held for the account that took it. The sharing model is
    // the same one the state document uses: two people who share a garden
    // share an account, so "only this uid" is exactly the right rule and no
    // cross-account grant is wanted. Kept out of the teachbench* trees on
    // purpose — this bucket serves two apps and their access rules have
    // nothing in common.
    //
    // Thumbnails do NOT live here. They ride inside the state document, which
    // is what lets a second device show recognisable plants instantly without
    // fetching anything. This is only ever the full-size original.
    match /pottingbenchPhotos/{userId}/{photoId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024          // 5 MB cap
        && request.resource.contentType.matches('image/.*'); // images only
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // teachbenchMessages/{studentId}/{messageId}/{fileName}
    // A photo attached to a chat message — a page of a book, a screenshot
    // of an exercise. Same limits as homework: the picture is there to be
    // looked at, not to turn the chat into a file store.
    match /teachbenchMessages/{studentId}/{msgId}/{fileName} {
      allow read: if canManage(studentId) || isThisStudent(studentId);
      allow write: if (canManage(studentId) || isThisStudent(studentId))
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024        // 10 MB cap
        && request.resource.contentType.matches('image/.*'); // images only
      allow delete: if canManage(studentId);
    }
  }
}
